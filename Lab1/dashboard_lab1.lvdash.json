    {
      "name": "co2_by_fuel_region",
      "displayName": "CO2 by Fuel Type and Region",
      "config": {
        "version": "1.1",
        "source": "SELECT country AS region, 'Coal' AS fuel_type, coal_co2 AS co2_value FROM dbr_dev.radekgryciukk.co2_owid_data WHERE year = (SELECT MAX(year) FROM dbr_dev.radekgryciukk.co2_owid_data WHERE coal_co2 IS NOT NULL)\n  AND iso_code IS NULL\n  AND country <> 'World'\n  AND coal_co2 IS NOT NULL\nUNION ALL SELECT country AS region, 'Oil' AS fuel_type, oil_co2 AS co2_value FROM dbr_dev.radekgryciukk.co2_owid_data WHERE year = (SELECT MAX(year) FROM dbr_dev.radekgryciukk.co2_owid_data WHERE oil_co2 IS NOT NULL)\n  AND iso_code IS NULL\n  AND country <> 'World'\n  AND oil_co2 IS NOT NULL\nUNION ALL SELECT country AS region, 'Gas' AS fuel_type, gas_co2 AS co2_value FROM dbr_dev.radekgryciukk.co2_owid_data WHERE year = (SELECT MAX(year) FROM dbr_dev.radekgryciukk.co2_owid_data WHERE gas_co2 IS NOT NULL)\n  AND iso_code IS NULL\n  AND country <> 'World'\n  AND gas_co2 IS NOT NULL\n",
        "dimensions": [
          {
            "name": "region",
            "expr": "region",
            "displayName": "Region"
          },
          {
            "name": "fuel_type",
            "expr": "fuel_type",
            "displayName": "Fuel Type"
          }
        ],
        "measures": [
          {
            "name": "total_co2",
            "expr": "SUM(co2_value)",
            "displayName": "Total CO2"
          }
        ]
      }
    },
    {
      "name": "top10_countries_co2",
      "displayName": "Top 10 Countries by Total CO2",
      "config": {
        "version": "1.1",
        "source": "SELECT country, SUM(co2) AS total_co2 FROM dbr_dev.radekgryciukk.co2_owid_data WHERE iso_code IS NOT NULL\n  AND iso_code <> ''\n  AND co2 IS NOT NULL\nGROUP BY country ORDER BY total_co2 DESC LIMIT 10\n",
        "dimensions": [
          {
            "name": "country",
            "expr": "country",
            "displayName": "Country"
          }
        ],
        "measures": [
          {
            "name": "total_co2",
            "expr": "SUM(total_co2)",
            "displayName": "Total CO2 (Mt)"
          }
        ]
      }
    }
